# ── Gemini AI (Primary AI Provider) ──────────────────────────────────────────
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=replace_with_gemini_api_key
# Model name, e.g. gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Active provider: gemini (default) or sarvam (optional legacy)
AI_PROVIDER=gemini

# ── Sarvam AI (Optional Legacy Provider + Voice Agents) ───────────────────────
# Only required if AI_PROVIDER=sarvam or if using Sarvam voice agent features
SARVAM_API_KEY=replace_with_sarvam_api_key
SARVAM_ORG_ID=replace_with_organization_id
SARVAM_WORKSPACE_ID=replace_with_workspace_id
SARVAM_APP_ID=replace_with_agent_app_id
SARVAM_TOOL_API_TOKEN=replace_with_a_long_random_webhook_token
# UUID of the business used by Sarvam voice webhooks
SARVAM_BUSINESS_ID=replace_with_business_uuid

# ── Supabase (Authentication) ─────────────────────────────────────────────────
# Get these from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=replace_with_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
